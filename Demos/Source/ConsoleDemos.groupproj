<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{F551D465-BD70-4243-AB07-C95C4B91DDFD}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="ProfilingConsole\ProfilingConsole.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="BenchmarksConsole\BenchmarksConsole.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Classify\Classify.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="SchemaConsole\SchemaConsole.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Playground\Playground.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="ProfilingConsole">
        <MSBuild Projects="ProfilingConsole\ProfilingConsole.dproj"/>
    </Target>
    <Target Name="ProfilingConsole:Clean">
        <MSBuild Projects="ProfilingConsole\ProfilingConsole.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ProfilingConsole:Make">
        <MSBuild Projects="ProfilingConsole\ProfilingConsole.dproj" Targets="Make"/>
    </Target>
    <Target Name="BenchmarksConsole">
        <MSBuild Projects="BenchmarksConsole\BenchmarksConsole.dproj"/>
    </Target>
    <Target Name="BenchmarksConsole:Clean">
        <MSBuild Projects="BenchmarksConsole\BenchmarksConsole.dproj" Targets="Clean"/>
    </Target>
    <Target Name="BenchmarksConsole:Make">
        <MSBuild Projects="BenchmarksConsole\BenchmarksConsole.dproj" Targets="Make"/>
    </Target>
    <Target Name="Classify">
        <MSBuild Projects="Classify\Classify.dproj"/>
    </Target>
    <Target Name="Classify:Clean">
        <MSBuild Projects="Classify\Classify.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Classify:Make">
        <MSBuild Projects="Classify\Classify.dproj" Targets="Make"/>
    </Target>
    <Target Name="SchemaConsole">
        <MSBuild Projects="SchemaConsole\SchemaConsole.dproj"/>
    </Target>
    <Target Name="SchemaConsole:Clean">
        <MSBuild Projects="SchemaConsole\SchemaConsole.dproj" Targets="Clean"/>
    </Target>
    <Target Name="SchemaConsole:Make">
        <MSBuild Projects="SchemaConsole\SchemaConsole.dproj" Targets="Make"/>
    </Target>
    <Target Name="Playground">
        <MSBuild Projects="Playground\Playground.dproj"/>
    </Target>
    <Target Name="Playground:Clean">
        <MSBuild Projects="Playground\Playground.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Playground:Make">
        <MSBuild Projects="Playground\Playground.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="ProfilingConsole;BenchmarksConsole;Classify;SchemaConsole;Playground"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="ProfilingConsole:Clean;BenchmarksConsole:Clean;Classify:Clean;SchemaConsole:Clean;Playground:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="ProfilingConsole:Make;BenchmarksConsole:Make;Classify:Make;SchemaConsole:Make;Playground:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
